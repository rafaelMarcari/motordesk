# Gere com:  python -m app.cli genkey
MASTER_KEY=
ADMIN_TOKEN=

DB_PATH=/data/notas.db

# mock = nao fala com governo (dev). nfse_nacional = Sefin Nacional
DRIVER=mock

# Confirme as URLs no Swagger oficial antes de usar
SEFIN_URL_HOMOLOGACAO=https://sefin.producaorestrita.nfse.gov.br/API/SefinNacional
SEFIN_URL_PRODUCAO=https://sefin.nfse.gov.br/API/SefinNacional

# Bundle PEM com a cadeia ICP-Brasil (se o trust store do sistema nao validar o servidor)
SEFIN_CA_BUNDLE=

# Confirme no manual oficial. Padrao observado na comunidade: sha1
SIGNATURE_HASH=sha1

# Pasta com os XSD oficiais da DPS (baixe do portal da NFS-e). Se XSD_REQUIRED=1, nao emite sem eles
XSD_DIR=/app/schemas/nfse
XSD_REQUIRED=0

HTTP_TIMEOUT=30
MAX_ATTEMPTS=6
ALLOW_INSECURE_WEBHOOKS=0

# Dominio para o Caddy (TLS automatico)
API_DOMAIN=nfe.seudominio.com.br
