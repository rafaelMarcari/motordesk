# ==========================================
# FRONTEND / VERCEL ENVIRONMENT VARIABLES
# ==========================================
# Public URL of the Express API running on Google Cloud Run
# Example: https://motordesk-605741677403.us-east1.run.app
VITE_API_URL=

# Firebase Auth Configuration (Public credentials safe for client bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ==========================================
# BACKEND / CLOUD RUN ENVIRONMENT VARIABLES
# ==========================================
# Server environment & port
NODE_ENV=production
PORT=3000

# Cloud SQL (PostgreSQL) Private Credentials
SQL_DB_NAME=cloud_sql_production_database
SQL_USER=
SQL_PASSWORD=
SQL_HOST=
INSTANCE_CONNECTION_NAME=centered-repeater-4x4wp:us-east1:ai-studio-482bfc36

# Allowed Origins for CORS (comma-separated list)
CORS_ALLOWED_ORIGINS=https://motordesk.app.br,https://www.motordesk.app.br
